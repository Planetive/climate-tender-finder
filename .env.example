# Backend
PORT=3001
ENABLE_AI_FILTERING=false
# Comma-separated Vercel + local origins (or * for open)
CORS_ORIGINS=*
# Optional — only needed if ENABLE_AI_FILTERING=true
GEMINI_API_KEY=

# Supabase (persist scraped/RSS opportunities — service role, NOT the anon key)
# Project URL from Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
# service_role secret — keep private; used only by the FastAPI backend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: POST JSON after each daily/manual ingest (Slack/Discord webhook, etc.)
# INGEST_WEBHOOK_URL=https://hooks.example.com/your-webhook
