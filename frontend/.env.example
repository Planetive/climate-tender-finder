# Optional. Leave unset on Vercel multi-service deploy — the app uses same-origin `/api`.
# Set this only if the API lives elsewhere (e.g. AWS EC2). Must include `/api`.
# VITE_API_URL=https://YOUR_EC2_OR_DOMAIN/api

# Optional Supabase (only if you use those features)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id
